<Project>
  <!-- Central package management: every version is set here, once. Dependabot keeps them up to date. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Installer and update framework. Keep in step with the vpk tool in .config/dotnet-tools.json. -->
    <PackageVersion Include="Velopack" Version="1.2.161" />

    <!-- Microsoft.Extensions.*: aligned with the .NET 10 LTS line. -->
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="10.0.15" />

    <!-- Tests: xUnit v3 on Microsoft Testing Platform (the dotnet test runner set in global.json). -->
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="coverlet.MTP" Version="10.1.0" />
  </ItemGroup>
</Project>
